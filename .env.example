# Public build configuration. Set release to the deployed commit SHA.
REACT_APP_ENV=production
REACT_APP_RELEASE=replace-with-git-commit-sha
REACT_APP_API_VERSION=v1
REACT_APP_API_URL_LOCAL=http://localhost:3005/api
REACT_APP_SERVER_URL_LOCAL=http://localhost:3005
REACT_APP_API_URL_STG=https://staging-api.example.com/api
REACT_APP_SERVER_URL_STG=https://staging-api.example.com
REACT_APP_API_URL_PROD=https://api.example.com/api
REACT_APP_SERVER_URL_PROD=https://api.example.com
# Public project token and ingest host.
REACT_APP_PUBLIC_POSTHOG_KEY=replace-with-public-project-token
REACT_APP_POSTHOG_HOST=https://us.i.posthog.com
# CI/build only; never give these variables a REACT_APP_ prefix.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com
